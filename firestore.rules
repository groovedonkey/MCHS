rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Leads submitted from the public contact form.
    // - Anyone may CREATE a lead (that's the point of a public contact form),
    //   but only if the payload matches the exact shape/size limits below.
    // - Nobody may read, update, or delete from the client. Leads are meant
    //   to be reviewed from the Firebase Console (or a future authenticated
    //   admin view) only, so a scraper can't harvest other customers' info
    //   and a bot can't overwrite/delete existing leads.
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidLead(d) {
    return d.keys().hasOnly(['name', 'phone', 'email', 'message', 'createdAt', 'source', 'page', 'userAgent', 'status'])
      && d.keys().hasAll(['name', 'phone', 'message', 'createdAt', 'source', 'status'])
      && d.name is string && d.name.size() > 0 && d.name.size() < 200
      && d.phone is string && d.phone.size() > 0 && d.phone.size() < 40
      && d.message is string && d.message.size() > 0 && d.message.size() < 4000
      && d.source is string && d.source.size() < 60
      && d.status == 'new'
      && d.createdAt == request.time
      && (!('email' in d) || (d.email is string && d.email.size() < 200))
      && (!('page' in d) || (d.page is string && d.page.size() < 300))
      && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() < 300));
  }
}
